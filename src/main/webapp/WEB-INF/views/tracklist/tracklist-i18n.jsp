<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>

<!-- TRACKLIST I18N -->

<div id="vc-tracklist-messages" hidden>

    <span data-message-key="tracklist.create.success">
        <spring:message code="tracklist.create.success"/>
    </span>
    <span data-message-key="tracklist.clear.modal.title">
        <spring:message code="tracklist.clear.modal.title"/>
    </span>

    <span data-message-key="tracklist.clear.modal.description">
        <spring:message code="tracklist.clear.modal.description"/>
    </span>

    <span data-message-key="tracklist.clear.success">
        <spring:message code="tracklist.clear.success"/>
    </span>

    <span data-message-key="tracklist.clear.error">
        <spring:message code="tracklist.clear.error"/>
    </span>
    <span data-message-key="tracklist.create.name.empty">
        <spring:message code="tracklist.create.name.empty"/>
    </span>

    <span data-message-key="tracklist.create.name.exists">
        <spring:message code="tracklist.create.name.exists"/>
    </span>

    <span data-message-key="tracklist.create.error">
        <spring:message code="tracklist.create.error"/>
    </span>

    <span data-message-key="tracklist.delete.success">
        <spring:message code="tracklist.delete.success"/>
    </span>

    <span data-message-key="tracklist.delete.error">
        <spring:message code="tracklist.delete.error"/>
    </span>

    <span data-message-key="tracklist.removeTrack.success">
        <spring:message code="tracklist.removeTrack.success"/>
    </span>

    <span data-message-key="tracklist.removeTrack.error">
        <spring:message code="tracklist.removeTrack.error"/>
    </span>

    <span data-message-key="tracklist.reorder.success">
        <spring:message code="tracklist.reorder.success"/>
    </span>

    <span data-message-key="tracklist.reorder.error">
        <spring:message code="tracklist.reorder.error"/>
    </span>

</div>