
<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>

<!-- BOX I18N -->

<div id="vc-box-messages" hidden>

    <span data-message-key="box.create.success">
        <spring:message code="box.create.success"/>
    </span>

    <span data-message-key="box.create.duplicate">
        <spring:message code="box.create.duplicate"/>
    </span>

    <span data-message-key="box.album.remove.success">
        <spring:message code="box.album.remove.success"/>
    </span>

    <span data-message-key="box.album.remove.notFound">
        <spring:message code="box.album.remove.notFound"/>
    </span>
    <span data-message-key="box.create.empty">
        <spring:message code="box.create.empty"/>
    </span>

    <span data-message-key="box.delete.success">
        <spring:message code="box.delete.success"/>
    </span>

    <span data-message-key="box.delete.error">
        <spring:message code="box.delete.error"/>
    </span>

    <span data-message-key="box.notFound">
        <spring:message code="box.notFound"/>
    </span>

    <span data-message-key="common.unexpectedError">
        <spring:message code="common.unexpectedError"/>
    </span>

</div>
