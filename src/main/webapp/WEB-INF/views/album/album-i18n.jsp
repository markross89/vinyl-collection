<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="spring" uri="http://www.springframework.org/tags" %>

<!-- ALBUM I18N -->

<div id="vc-messages" hidden>

    <!-- BOX MODAL -->

    <span data-message-key="loading">
        <spring:message code="box.loading"/>
    </span>
    <span data-message-key="removeSuccess">
        <spring:message code="box.album.remove.success"/>
    </span>
    <span data-message-key="album.remove.success">
        <spring:message code="album.remove.success"/>
    </span>

    <span data-message-key="album.remove.error">
        <spring:message code="album.remove.error"/>
    </span>

    <span data-message-key="common.unexpectedError">
        <spring:message code="common.unexpectedError"/>
    </span>

    <span data-message-key="removeError">
        <spring:message code="box.update.error"/>
    </span>

    <span data-message-key="loadError">
        <spring:message code="box.load.error"/>
    </span>

    <span data-message-key="empty">
        <spring:message code="box.empty"/>
    </span>

    <span data-message-key="add">
        <spring:message code="box.action.add"/>
    </span>

    <span data-message-key="remove">
        <spring:message code="box.action.remove"/>
    </span>

    <span data-message-key="enterName">
        <spring:message code="box.create.enterName"/>
    </span>

    <span data-message-key="addSuccess">
        <spring:message code="box.add.success"/>
    </span>

    <span data-message-key="updateError">
        <spring:message code="box.update.error"/>
    </span>

    <span data-message-key="createSuccess">
        <spring:message code="box.create.withAlbum.success"/>
    </span>

    <span data-message-key="createError">
        <spring:message code="box.create.error"/>
    </span>

    <!-- COMMON -->

    <span data-message-key="unexpectedError">
        <spring:message code="common.unexpectedError"/>
    </span>

</div>